DATABASE_URL=sqlite://./db.sqlite3?mode=rwc
RUST_LOG=info
TELEGRAM_BOT_TOKEN=<bot token>
TELEGRAM_REQUIRED_GROUP_ID=@MeMe_Web_Support
TEMPLATE_CATALOG_URL=https://example.com/templates
ADMIN_CONTACT=@your_admin
# Website prices in USDT
# Comma-separated list of 12 prices, one per template (template_01 .. template_12)
TEMPLATE_PRICES_USDT=30,30,30,40,40,40,50,50,50,60,60,60
# Template preview site domain suffix (e.g. "web" → 01.web, 02.web, …, 12.web)
TEMPLATE_PREVIEW_DOMAIN=web
# Template preview base URL (e.g. "https://memewebs.xyz" → https://memewebs.xyz/01, …, /12)
TEMPLATE_PREVIEW_BASE_URL=https://memewebs.xyz
AI_CREATION_PRICE_USDT=50
# Example: TELOXIDE_PROXY=http://127.0.0.1:7890
TELOXIDE_PROXY=

# Required receive addresses. The bot only confirms payments sent to these values.
USDT_ERC20_ADDRESS=
USDT_TRON_ADDRESS=
USDT_SOL_ADDRESS=
USDT_ERC20_RPC_URL=
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_ERC20_MIN_CONFIRMATIONS=12
TRON_GRID_BASE_URL=https://api.trongrid.io
TRON_GRID_API_KEY=
USDT_TRON_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TRON_MIN_CONFIRMATIONS=20
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
USDT_SOL_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoT1r9tnmTaGJQG7uC
USDT_SOL_MIN_CONFIRMATIONS=1

GENERATION_MAX_CONCURRENCY=2
GENERATION_PRIMARY_PROVIDER=gemini
AGENT_TIMEOUT_SECONDS=900
GEMINI_AGENT_COMMAND=gemini
GEMINI_AGENT_ARGS="--yolo --prompt-file {prompt_file}"
CODEX_AGENT_COMMAND=codex
CODEX_AGENT_ARGS="exec --dangerously-bypass-approvals-and-sandbox --cd {output_dir} --file {prompt_file}"
CLAUDE_AGENT_COMMAND=claude
CLAUDE_AGENT_ARGS="-p {prompt} --output-format stream-json --verbose --allowedTools Read Edit Write Bash --permission-mode plan --dangerously-bypass-sandbox"
GENERATED_SITES_DIR=/www/websites
LOCAL_TEMPLATES_DIR=./templates

# meme-bot creates GitHub repositories and pushes generated site code.
GITHUB_OWNER=
GITHUB_TOKEN=

# meme-bot calls api-server for Namecheap, DNS, and Cloudflare Pages operations.
API_SERVICE_BASE_URL=http://127.0.0.1:8080
API_SERVICE_API_KEY=<same value as api-server>

# Enables the paid order flow to continue after payment confirmation.
NAMECHEAP_AUTO_PURCHASE_AFTER_TX=true
