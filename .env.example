DATABASE_URL=sqlite://./db.sqlite3
TELEGRAM_BOT_TOKEN=<bot token>
TELEGRAM_REQUIRED_GROUP_ID=@MeMe_Web_Support
TEMPLATE_CATALOG_URL=https://example.com/templates
ADMIN_CONTACT=@your_admin
# Required in networks that cannot directly reach api.telegram.org.
# Example: TELOXIDE_PROXY=http://127.0.0.1:7890
TELOXIDE_PROXY=

# Required receive addresses. The bot only confirms payments sent to these .env values.
USDT_ERC20_ADDRESS=
USDT_TRON_ADDRESS=
USDT_SOL_ADDRESS=
USDT_ERC20_RPC_URL=
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_ERC20_MIN_CONFIRMATIONS=12
TRON_GRID_BASE_URL=https://api.trongrid.io
TRON_GRID_API_KEY=
USDT_TRON_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TRON_MIN_CONFIRMATIONS=20
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
USDT_SOL_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoT1r9tnmTaGJQG7uC
USDT_SOL_MIN_CONFIRMATIONS=1

GENERATION_MAX_CONCURRENCY=2
GENERATION_PRIMARY_PROVIDER=gemini
AGENT_TIMEOUT_SECONDS=900
GEMINI_AGENT_COMMAND=gemini
GEMINI_AGENT_ARGS=--yolo --prompt-file {prompt_file}
CODEX_AGENT_COMMAND=codex
CODEX_AGENT_ARGS=exec --dangerously-bypass-approvals-and-sandbox --cd {output_dir} --file {prompt_file}
GENERATED_SITES_DIR=./generated-sites
LOCAL_TEMPLATES_DIR=./templates

# The bot creates GitHub repositories under this owner. Repo name is the requested domain, e.g. pepe.xyz.
GITHUB_OWNER=
GITHUB_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WRANGLER_COMMAND=npx
CLOUDFLARE_WRANGLER_ARGS=wrangler pages deploy {site_dir} --project-name={project_name} --branch={branch}

NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true
# Required for the automated paid order flow. If false, paid orders pause for manual review before generation.
NAMECHEAP_AUTO_PURCHASE_AFTER_TX=true
NAMECHEAP_CONTACT_FIRST_NAME=
NAMECHEAP_CONTACT_LAST_NAME=
NAMECHEAP_CONTACT_ADDRESS1=
NAMECHEAP_CONTACT_CITY=
NAMECHEAP_CONTACT_STATE=
NAMECHEAP_CONTACT_POSTAL_CODE=
NAMECHEAP_CONTACT_COUNTRY=US
NAMECHEAP_CONTACT_PHONE=+1.5555555555
NAMECHEAP_CONTACT_EMAIL=
NAMECHEAP_CONTACT_ORGANIZATION=
