# This repository now uses separate env files per binary:
# - meme-bot loads .env.meme-bot by default.
# - api-server loads .env.api-server by default.
# Copy the split examples instead of using this file directly:
#
#   cp .env.meme-bot.example .env.meme-bot
#   cp .env.api-server.example .env.api-server
#
# You can override the paths with:
#   MEME_BOT_ENV_FILE=/path/to/bot.env cargo run --bin meme-bot
#   API_SERVER_ENV_FILE=/path/to/api.env cargo run --bin api-server
